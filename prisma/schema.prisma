// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id
  name            String
  email           String
  emailVerified   Boolean         @default(false)
  image           String?
  mobileNumber    String?
  whatsappNumber  String?
  profileImageKey String?
  upiId           String?
  aadhaarNumber   String?
  state           String?
  district        String?
  collegeName     String?
  collegeAddress  String?
  
  // Personal Details (Extended)
  username        String?         @unique
  firstName       String?
  middleName      String?
  lastName        String?
  
  // Academic Details
  registration    String?
  rollNumber      String?
  branch          String?
  admissionYear   String?
  
  // Address Details (Detailed)
  address         String?
  postOffice      String?
  policeStation   String?
  block           String?
  pinCode         String?
  
  // Profile completion status
  profileComplete Boolean         @default(false)
  
  // Linked Accounts
  githubUsername  String?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  role            String?
  banned          Boolean?        @default(false)
  banReason       String?
  banExpires      DateTime?
  sessions        Session[]
  accounts        Account[]
  supportTickets  SupportTicket[]
  supportResponses SupportResponse[]
  adminResponses  SupportResponse[] @relation("AdminResponses")
  publishedProjects PublishedProject[]
  projectReviews  ProjectReview[]
  resourceFolders ResourceFolder[]  @relation("ResourceFolderCreator")
  resources       Resource[]        @relation("ResourceUploader")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("system_settings")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id          String                @id @default(cuid())
  ticketNumber String               @unique
  userId      String
  name        String
  email       String
  mobileNumber String?
  whatsappNumber String?
  subject     String
  message     String
  status      SupportTicketStatus  @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  resolvedAt  DateTime?
  
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]
  responses   SupportResponse[]

  @@map("support_ticket")
}

model SupportAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  fileName  String
  fileKey   String   // S3 key for the uploaded file
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())
  
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_attachment")
}

model SupportResponse {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String?  // null if admin response
  adminId    String?  // null if user response
  message    String
  isInternal Boolean  @default(false) // Internal notes not visible to users
  createdAt  DateTime @default(now())
  
  ticket      SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  admin       User?                     @relation("AdminResponses", fields: [adminId], references: [id], onDelete: SetNull)
  attachments SupportResponseAttachment[]

  @@map("support_response")
}

model SupportResponseAttachment {
  id         String   @id @default(cuid())
  responseId String
  fileName   String
  fileSize   Int
  mimeType   String
  fileKey    String   // S3 key for the file
  createdAt  DateTime @default(now())

  response   SupportResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@map("support_response_attachment")
}

enum AnnouncementCategory {
  EMERGENCY
  GENERAL
  EVENT_UPDATE
  WORKSHOP
  LOGISTICS
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementAudience {
  PUBLIC
  PARTICIPANTS_ONLY
  VOLUNTEERS_ONLY
  ORGANIZERS_ONLY
}

enum RecurrenceType {
  NONE
  HOURLY
  DAILY
  WEEKLY
}

model Announcement {
  id          String   @id @default(cuid())
  slugId      String   @unique
  title       String
  description String   // Rich text content
  category    AnnouncementCategory
  priority    AnnouncementPriority @default(NORMAL)
  
  // Media & attachments
  attachmentKeys String[] @default([]) // S3 keys for PDFs, documents
  imageKeys      String[] @default([]) // S3 keys for images/posters
  
  // Visibility & control
  audience           AnnouncementAudience @default(PUBLIC)
  sendNotifications  Boolean             @default(false)
  isPinned          Boolean             @default(false)
  showInHomeBanner  Boolean             @default(false)
  
  // Scheduling
  publishDate DateTime @default(now())
  expiryDate  DateTime?
  
  // Recurring announcements
  isRecurring     Boolean        @default(false)
  recurrenceType  RecurrenceType @default(NONE)
  recurrenceInterval Int?        // For custom intervals (e.g., every 2 hours)
  lastRecurrenceRun DateTime?    // Track last time recurring announcement was processed
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   // Admin user ID who created this
  
  // Soft delete
  isDeleted Boolean @default(false)
  deletedAt DateTime?
  
  @@map("announcement")
}

model AttendanceSession {
  id            String       @id @default(cuid())
  sessionNumber Int
  title         String
  date          DateTime
  day           String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String       // Admin user ID who created this
  attendances   Attendance[]

  @@unique([sessionNumber])
  @@map("attendance_session")
}

model Attendance {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  status    String   // "pending", "present", "absent"
  points    Int      @default(0) // Points awarded for attendance
  markedAt  DateTime @default(now())
  markedBy  String   // Admin user ID who marked the attendance
  updatedAt DateTime @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("attendance")
}

model Task {
  id          String           @id @default(cuid())
  taskNumber  Int
  title       String
  description String?
  startDate   DateTime
  dueDate     DateTime
  points      Int              @default(0) // Points awarded for task completion
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String           // Admin user ID who created this
  submissions TaskSubmission[]

  @@unique([taskNumber])
  @@map("task")
}

model TaskSubmission {
  id             String    @id @default(cuid())
  taskId         String
  userId         String
  status         String    // "pending", "submitted", "approved", "rejected"
  projectUrl     String?   // GitHub repository or project URL
  screenshotKey  String?   // S3 key for screenshot (max 100kb)
  submittedAt    DateTime?
  evaluatedAt    DateTime?
  evaluatedBy    String?   // Admin user ID who evaluated
  pointsAwarded  Int       @default(0)
  feedback       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@map("task_submission")
}

model EventPoint {
  id          String   @id @default(cuid())
  eventNumber Int
  title       String
  description String?
  eventDate   DateTime
  points      Int      @default(0) // Points awarded for event participation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String   // Admin user ID who created this
  participations EventParticipation[]

  @@unique([eventNumber])
  @@map("event_point")
}

model EventParticipation {
  id             String    @id @default(cuid())
  eventId        String
  userId         String
  status         String    // "pending", "participated", "approved", "rejected"
  participatedAt DateTime?
  evaluatedAt    DateTime?
  evaluatedBy    String?   // Admin user ID who evaluated
  pointsAwarded  Int       @default(0)
  feedback       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  event EventPoint @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_participation")
}

model Quiz {
  id               String         @id @default(cuid())
  quizId           String         @unique // CODEBREAKER-QUIZZES-randomstring
  title            String
  description      String         @db.Text // Description and rules
  sets             Int            @default(1) // Number of sets (1-8)
  duration         Int            // Duration in minutes
  pointsPerQuestion Int           @default(1) // Points awarded per correct answer
  startDateTime    DateTime?      // Quiz start date and time
  endDateTime      DateTime?      // Quiz end date and time
  questionsJson    String         @db.Text // JSON string of questions
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String         // Admin user ID who created this
  attempts         QuizAttempt[]
  setAssignments   QuizSetAssignment[]

  @@map("quiz")
}

model QuizSetAssignment {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  assignedSet String   // The set letter (A, B, C, etc.)
  assignedAt  DateTime @default(now())
  
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  @@unique([quizId, userId])
  @@map("quiz_set_assignment")
}

model QuizAttempt {
  id             String    @id @default(cuid())
  quizId         String
  userId         String
  setNumber      Int       // Which set (A, B, C, etc.)
  score          Int       @default(0)
  totalQuestions Int
  correctAnswers Int       @default(0)
  pointsEarned   Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  answersJson    String?   @db.Text // JSON string of user's answers
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId, setNumber])
  @@map("quiz_attempt")
}

model QuizBlock {
  id              String   @id @default(cuid())
  quizId          String
  userId          String
  reason          String   @db.Text // Reason for blocking (e.g., "Multiple violations detected")
  violationType   String   // Type of violation (e.g., "TAB_SWITCH", "FULLSCREEN_EXIT")
  violationCount  Int      @default(0) // Number of violations before block
  blockedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([quizId, userId])
  @@index([userId])
  @@index([quizId])
  @@map("quiz_block")
}

model PublishedProject {
  id              String   @id @default(cuid())
  githubRepoId    Int      @unique // GitHub repository ID
  title           String
  description     String   @db.Text
  techStack       String[] // Array of technologies
  projectUrl      String?  // Optional live project URL
  thumbnailKey    String   // S3 key for thumbnail image
  publishedById   String   // Admin who published
  publishedBy     User     @relation(fields: [publishedById], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([publishedById])
  @@map("published_project")
}

model ProjectReview {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoName        String
  repoUrl         String
  description     String   @db.Text
  reviewType      String   // "review", "collaboration", "publish"
  explanation     String   @db.Text
  liveUrl         String?
  whatsappNumber  String?
  status          String   @default("pending") // "pending", "approved", "rejected"
  adminResponse   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([reviewType])
  @@map("project_review")
}

model ResourceFolder {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  icon        String?  // Icon name or emoji
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("ResourceFolderCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  resources   Resource[]

  @@index([createdById])
  @@index([order])
  @@map("resource_folder")
}

model Resource {
  id          String         @id @default(cuid())
  folderId    String
  folder      ResourceFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  title       String
  description String?        @db.Text
  type        String         // "pdf", "image", "video", "document", "link"
  url         String         // Google Drive link, YouTube link, or direct URL
  thumbnailUrl String?       // Optional thumbnail for videos/images
  fileSize    String?        // File size (e.g., "2.5 MB")
  duration    String?        // For videos (e.g., "5:30")
  tags        String[]       // Array of tags for filtering
  order       Int            @default(0)
  isActive    Boolean        @default(true)
  downloadable Boolean       @default(true)
  uploadedById String
  uploadedBy  User           @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([folderId])
  @@index([uploadedById])
  @@index([type])
  @@index([order])
  @@map("resource")
}

