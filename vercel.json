{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "app/api/**/*": {
      "maxDuration": 30
    }
  },
  "buildCommand": "npx prisma generate && npm run build",
  "installCommand": "npm install",
  "git": {
    "deploymentEnabled": {
      "dev": false
    }
  }
}